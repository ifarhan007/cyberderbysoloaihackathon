# Copy this file to .env and paste your Gemini API key (https://aistudio.google.com/apikey).
# .env is git-ignored and is NEVER included in code.zip.
GEMINI_API_KEY=your_key_here
# Primary model + comma-separated fallbacks (tried in order if the primary is overloaded/unavailable)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
